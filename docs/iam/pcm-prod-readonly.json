{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LecturaInventario",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeRegions",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeImages",
        "ec2:DescribeVolumes",
        "ec2:DescribeAddresses",
        "ec2:DescribeTags",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeKeyPairs",
        "rds:DescribeDBInstances",
        "rds:DescribeDBSnapshots",
        "rds:ListTagsForResource",
        "route53:ListHostedZones",
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:GetChange",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "ce:GetCostAndUsage",
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation",
        "ssm:ListCommands",
        "ssm:ListCommandInvocations",
        "ssm:DescribeDocument",
        "ssm:GetDocument"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DiscoverySoloConElDocumentoPropio",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:*:<ACCOUNT_ID>:document/pcm-readonly-discovery",
        "arn:aws:ec2:*:<ACCOUNT_ID>:instance/*"
      ]
    },
    {
      "Sid": "SalidaDelDiscoveryPorS3Opcional",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET_SALIDA_DISCOVERY>",
        "arn:aws:s3:::<BUCKET_SALIDA_DISCOVERY>/pcm-readonly-discovery/*"
      ]
    },
    {
      "Sid": "MaquinasNoCreadasPorPCMIntocables",
      "Effect": "Deny",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:AssociateIamInstanceProfile",
        "ec2:ReplaceIamInstanceProfileAssociation",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:ModifyVolume",
        "ec2:CreateSnapshot",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/primate:managed_by": "pcm"
        }
      }
    },
    {
      "Sid": "EtiquetasDeLoAjenoIntocables",
      "Effect": "Deny",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/primate:managed_by": "pcm",
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateSecurityGroup",
            "AllocateAddress"
          ]
        }
      }
    },
    {
      "Sid": "BasesRdsNoCreadasPorPCMIntocables",
      "Effect": "Deny",
      "Action": [
        "rds:ModifyDBInstance",
        "rds:DeleteDBInstance",
        "rds:RebootDBInstance",
        "rds:StopDBInstance",
        "rds:StartDBInstance",
        "rds:RestoreDBInstanceFromDBSnapshot",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "rds:db-tag/primate:managed_by": "pcm"
        }
      }
    },
    {
      "Sid": "SinSesionesNiAutomatizacionesNiDocumentos",
      "Effect": "Deny",
      "Action": [
        "ssm:StartSession",
        "ssm:ResumeSession",
        "ssm:StartAutomationExecution",
        "ssm:CreateDocument",
        "ssm:UpdateDocument",
        "ssm:UpdateDocumentDefaultVersion",
        "ssm:DeleteDocument",
        "ssm:ModifyDocumentPermission",
        "ssm:CreateAssociation",
        "ssm:UpdateAssociation",
        "ssm:PutParameter",
        "route53:CreateHostedZone",
        "route53:DeleteHostedZone",
        "route53domains:*",
        "organizations:*",
        "account:*",
        "iam:Create*",
        "iam:Delete*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Detach*",
        "iam:Update*",
        "iam:Add*",
        "iam:Remove*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Set*",
        "iam:Upload*",
        "iam:Enable*",
        "iam:Deactivate*",
        "iam:Reset*",
        "iam:Change*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NadieTocaLaLlaveDePropiedadEnRecursosExistentes",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEqualsIgnoreCase": {
          "aws:TagKeys": [
            "primate:managed_by"
          ]
        },
        "StringNotEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateSecurityGroup",
            "AllocateAddress"
          ]
        }
      }
    },
    {
      "Sid": "NuncaBorrarEtiquetas",
      "Effect": "Deny",
      "Action": "ec2:DeleteTags",
      "Resource": "*"
    }
  ]
}
