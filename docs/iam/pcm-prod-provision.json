{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LecturasParaOperarLoPropio",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeRegions",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeImages",
        "ec2:DescribeVolumes",
        "ec2:DescribeAddresses",
        "ec2:DescribeTags",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeRouteTables",
        "route53:GetHostedZone",
        "route53:GetChange",
        "route53:ListResourceRecordSets",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "iam:GetInstanceProfile"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AmiPublicaDeCanonical",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:*::parameter/aws/service/canonical/ubuntu/*"
    },
    {
      "Sid": "CrearInstanciaSoloEtiquetadaPorPCM",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*:<ACCOUNT_ID>:instance/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/primate:managed_by": "pcm"
        }
      }
    },
    {
      "Sid": "RecursosAuxiliaresDeRunInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:network-interface/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:key-pair/*"
      ]
    },
    {
      "Sid": "EtiquetarSoloAlCrear",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateSecurityGroup",
            "AllocateAddress"
          ]
        }
      }
    },
    {
      "Sid": "CicloDeVidaSoloDeLoDePCM",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "arn:aws:ec2:*:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/primate:managed_by": "pcm"
        }
      }
    },
    {
      "Sid": "SecurityGroupPropioEtiquetado",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:*:<ACCOUNT_ID>:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/primate:managed_by": "pcm"
        }
      }
    },
    {
      "Sid": "SecurityGroupEnLaVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:*:<ACCOUNT_ID>:vpc/*"
    },
    {
      "Sid": "ReglasSoloEnElSecurityGroupDePCM",
      "Effect": "Allow",
      "Action": "ec2:AuthorizeSecurityGroupIngress",
      "Resource": "arn:aws:ec2:*:<ACCOUNT_ID>:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/primate:managed_by": "pcm"
        }
      }
    },
    {
      "Sid": "ElasticIpPropia",
      "Effect": "Allow",
      "Action": [
        "ec2:AllocateAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/primate:managed_by": "pcm"
        }
      }
    },
    {
      "Sid": "AsociarEipSoloEntreRecursosDePCM",
      "Effect": "Allow",
      "Action": "ec2:AssociateAddress",
      "Resource": [
        "arn:aws:ec2:*:<ACCOUNT_ID>:elastic-ip/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/primate:managed_by": "pcm"
        }
      }
    },
    {
      "Sid": "PasarSoloElRolDeSSMDePCM",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/pcm-ssm-role<SUFIJO>",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ShellDeInstalacionDocumento",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:*:*:document/AWS-RunShellScript"
    },
    {
      "Sid": "ShellDeInstalacionSoloEnMaquinasDePCM",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:*:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/primate:managed_by": "pcm"
        }
      }
    },
    {
      "Sid": "DnsSoloNombresDePCMEnLaZonaReal",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/<ZONE_ID>",
      "Condition": {
        "ForAllValues:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "<NOMBRES_DNS_DE_PCM>"
          ]
        },
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "A"
          ],
          "route53:ChangeResourceRecordSetsActions": [
            "CREATE",
            "UPSERT",
            "DELETE"
          ]
        }
      }
    },
    {
      "Sid": "CrearBucketsDePCM",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::pcm-*-<ACCOUNT_ID><SUFIJO>"
    },
    {
      "Sid": "BucketsDePCMDeEstaCuenta",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetLifecycleConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::pcm-*-<ACCOUNT_ID><SUFIJO>",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<ACCOUNT_ID>"
        }
      }
    },
    {
      "Sid": "ObjetosDeLosBucketsDePCM",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::pcm-*-<ACCOUNT_ID><SUFIJO>/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<ACCOUNT_ID>"
        }
      }
    },
    {
      "Sid": "SubirDumpsSoloAlBucketDePCM",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::pcm-dumps-<ACCOUNT_ID><SUFIJO>/incoming/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<ACCOUNT_ID>"
        }
      }
    },
    {
      "Sid": "NadieTocaLaLlaveDePropiedadEnRecursosExistentes",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEqualsIgnoreCase": {
          "aws:TagKeys": [
            "primate:managed_by"
          ]
        },
        "StringNotEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateSecurityGroup",
            "AllocateAddress"
          ]
        }
      }
    },
    {
      "Sid": "NuncaBorrarEtiquetas",
      "Effect": "Deny",
      "Action": "ec2:DeleteTags",
      "Resource": "*"
    }
  ]
}
