<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="primate_cloud_manager.DnsDetalle">
        <div class="o_pcm_detalle">
            <div t-if="state.loading" class="o_pcm_muted">Cargando…</div>
            <div t-elif="!d.id" class="o_pcm_card o_pcm_muted">No se encontró el registro.</div>

            <t t-else="">
                <!-- Hero -->
                <div class="o_pcm_hero o_pcm_card">
                    <div class="o_pcm_hero_head">
                        <h1 t-out="d.name"/>
                        <PcmStatusBadge value="d.sync_state"
                                        model="'primate.cloud.dns.record'"
                                        field="'sync_state'" label="d.sync_state_label"/>
                        <span class="o_pcm_spacer"/>
                        <div class="o_pcm_actions" t-if="!d.is_deleted">
                            <button class="o_pcm_btn" t-on-click="() => this.checkDns()">
                                <i class="fa fa-refresh"/> Verificar
                            </button>
                            <button class="o_pcm_btn" t-on-click="() => this.editDns()">
                                <i class="fa fa-pencil"/> Editar
                            </button>
                            <button class="o_pcm_btn o_pcm_btn_danger" t-on-click="() => this.deleteDns()">
                                <i class="fa fa-trash"/> Eliminar
                            </button>
                        </div>
                    </div>
                    <div t-if="d.sync_state === 'divergent'" class="o_pcm_muted o_pcm_mono">
                        Valor real en AWS: <t t-out="d.record_value_aws"/>
                    </div>
                </div>

                <!-- Error de sync accionable, visible en el panel (no sólo en la
                     bitácora): qué pasó y qué hacer, con el crudo plegable. -->
                <div t-if="d.sync_state === 'error' and d.sync_error"
                     class="o_pcm_form_banner o_pcm_form_banner_error o_pcm_panel_banner">
                    <i class="fa fa-exclamation-triangle"/>
                    <div class="o_pcm_panel_banner_body">
                        <div t-out="d.sync_error"/>
                        <details t-if="d.sync_error_detail" class="o_pcm_banner_detail">
                            <summary>Ver detalle técnico</summary>
                            <pre class="o_pcm_mono o_pcm_banner_pre" t-out="d.sync_error_detail"/>
                        </details>
                    </div>
                </div>

                <div class="o_pcm_cols2">
                    <div class="o_pcm_card">
                        <h2>General</h2>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Tipo de registro</span><span t-out="d.record_type or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Valor</span><span class="o_pcm_mono" t-out="d.record_value or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">TTL</span><span t-out="d.ttl or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Hosted Zone</span><span class="o_pcm_mono" t-out="d.hosted_zone_id or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Último sync</span><span t-out="d.last_sync_date or '—'"/></div>
                    </div>
                    <div class="o_pcm_card">
                        <h2>Asociación</h2>
                        <div class="o_pcm_kv">
                            <span class="o_pcm_muted">Entorno</span>
                            <span t-if="d.environment_id" class="o_pcm_link"
                                  t-on-click="() => this.openRecord('primate.cloud.environment', d.environment_id, d.environment_name)"
                                  t-out="d.environment_name"/>
                            <span t-else="">—</span>
                        </div>
                        <div class="o_pcm_kv">
                            <span class="o_pcm_muted">Cuenta</span>
                            <span t-if="d.account_id" class="o_pcm_link"
                                  t-on-click="() => this.openRecord('primate.cloud.account', d.account_id, d.account_name)"
                                  t-out="d.account_name"/>
                            <span t-else="">—</span>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
