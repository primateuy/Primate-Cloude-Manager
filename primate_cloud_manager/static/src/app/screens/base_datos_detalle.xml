<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="primate_cloud_manager.BaseDatosDetalle">
        <div class="o_pcm_detalle">
            <div t-if="state.loading" class="o_pcm_muted">Cargando…</div>
            <div t-elif="!d.id" class="o_pcm_card o_pcm_muted">No se encontró el registro.</div>

            <t t-else="">
                <!-- Hero -->
                <div class="o_pcm_hero o_pcm_card">
                    <div class="o_pcm_hero_head">
                        <h1 t-out="d.name"/>
                        <PcmStatusBadge value="d.state"
                                        model="'primate.cloud.database'"
                                        field="'state'" label="d.state_label"/>
                        <span class="o_pcm_spacer"/>
                        <div class="o_pcm_actions">
                            <button class="o_pcm_btn" t-on-click="() => this.editDb()">
                                <i class="fa fa-pencil"/> Editar
                            </button>
                        </div>
                    </div>
                </div>

                <div class="pcm-grid pcm-grid--pair">
                    <!-- General + uso/estado en vivo (métricas de runtime): equilibra
                         el par contra la config de RDS para que ninguna quede vacía. -->
                    <div class="o_pcm_card">
                        <h2>General y uso</h2>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Tipo</span><span t-out="d.db_type_label or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Versión PostgreSQL</span><span t-out="d.pg_version or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Estado</span><span t-out="d.state_label or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Almacenamiento usado</span><span t-out="d.storage_used_gb ? d.storage_used_gb + ' GB' : '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Conexiones activas</span><span t-out="d.active_connections or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Último backup</span><span t-out="d.last_backup_date or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Último sync</span><span t-out="d.last_sync_date or '—'"/></div>
                    </div>
                    <!-- Configuración de RDS (parámetros del recurso). -->
                    <div class="o_pcm_card">
                        <h2>Almacenamiento / RDS</h2>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Identificador RDS</span><span class="o_pcm_mono" t-out="d.rds_identifier or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Endpoint RDS</span><span class="o_pcm_mono" t-out="d.rds_endpoint or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Clase de instancia</span><span t-out="d.rds_instance_class or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Almacenamiento</span><span t-out="d.rds_storage_gb ? d.rds_storage_gb + ' GB' : '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Multi-AZ</span><span t-out="d.rds_multi_az ? 'Sí' : 'No'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Retención de backups</span><span t-out="d.backup_retention_days or '—'"/></div>
                    </div>
                </div>

                <div class="o_pcm_card">
                    <h2>Asociación</h2>
                    <div class="o_pcm_kv">
                        <span class="o_pcm_muted">Entorno</span>
                        <span t-if="d.environment_id" class="o_pcm_link"
                              t-on-click="() => this.openRecord('primate.cloud.environment', d.environment_id, d.environment_name)"
                              t-out="d.environment_name"/>
                        <span t-else="">—</span>
                    </div>
                    <div class="o_pcm_kv">
                        <span class="o_pcm_muted">Cuenta</span>
                        <span t-if="d.account_id" class="o_pcm_link"
                              t-on-click="() => this.openRecord('primate.cloud.account', d.account_id, d.account_name)"
                              t-out="d.account_name"/>
                        <span t-else="">—</span>
                    </div>
                    <div class="o_pcm_kv">
                        <span class="o_pcm_muted">Servidor</span>
                        <span t-if="d.server_id" class="o_pcm_link"
                              t-on-click="() => this.openRecord('primate.cloud.ec2.instance', d.server_id, d.server_name)"
                              t-out="d.server_name"/>
                        <button t-else="" class="o_pcm_btn"
                                t-on-click="() => this.editDb()">
                            <i class="fa fa-link"/> Asociar a una instancia…
                        </button>
                    </div>
                </div>

                <!-- Respaldos de esta base (el chip dice para qué se ejecutó) -->
                <div class="o_pcm_section_head o_pcm_section_bar">
                    <h2>Respaldos</h2>
                </div>
                <div t-if="!(d.backups or []).length" class="o_pcm_card o_pcm_muted">
                    Sin backups registrados para esta base.
                </div>
                <div t-else="" class="o_pcm_card">
                    <div t-foreach="d.backups" t-as="bk" t-key="bk.id" class="o_pcm_line">
                        <span class="o_pcm o_pcm_chip" t-out="bk.purpose_label"/>
                        <div class="o_pcm_line_main">
                            <span class="o_pcm_line_name" t-out="bk.date"/>
                            <span class="o_pcm_muted" t-if="bk.size_mb"> · <t t-out="bk.size_mb"/> MB</span>
                        </div>
                        <PcmStatusBadge value="bk.state" model="'primate.cloud.backup'"
                                        field="'state'" label="bk.state_label"/>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
