<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="primate_cloud_manager.ServidorDetalle">
        <div class="o_pcm_detalle">
            <div t-if="state.loading" class="o_pcm_muted">Cargando…</div>
            <div t-elif="!d.id" class="o_pcm_card o_pcm_muted">No se encontró el servidor.</div>

            <t t-else="">
                <!-- Hero + acciones -->
                <div class="o_pcm_hero o_pcm_card">
                    <div class="o_pcm_hero_head">
                        <h1 t-out="d.name"/>
                        <PcmStatusBadge value="d.state"
                                        model="'primate.cloud.ec2.instance'"
                                        field="'instance_state'" label="d.state_label"/>
                        <span class="o_pcm_spacer"/>
                    </div>
                    <div class="o_pcm_actions">
                        <button t-if="d.state === 'stopped'" class="o_pcm_btn o_pcm_btn_accent"
                                t-on-click="() => this.runMethod('action_start')">
                            <i class="fa fa-play"/> Iniciar
                        </button>
                        <button t-if="d.state === 'running'" class="o_pcm_btn"
                                t-on-click="() => this.runMethod('action_stop', { confirm: '¿Detener esta instancia?' })">
                            <i class="fa fa-stop"/> Detener
                        </button>
                        <button t-if="d.state === 'running'" class="o_pcm_btn"
                                t-on-click="() => this.runMethod('action_restart', { confirm: '¿Reiniciar esta instancia?' })">
                            <i class="fa fa-refresh"/> Reiniciar
                        </button>
                        <button class="o_pcm_btn"
                                t-on-click="() => this.runMethod('action_sync_from_aws')">
                            <i class="fa fa-cloud-download"/> Sincronizar
                        </button>
                        <button t-if="d.state === 'running'" class="o_pcm_btn"
                                t-on-click="() => this.runMethod('action_create_staging_from_instance')">
                            <i class="fa fa-clone"/> Crear staging
                        </button>
                        <button t-if="d.state === 'running'" class="o_pcm_btn"
                                t-on-click="() => this.runMethod('action_execute_command')">
                            <i class="fa fa-terminal"/> Ejecutar comando
                        </button>
                        <button t-if="d.state !== 'terminated'" class="o_pcm_btn o_pcm_btn_danger"
                                t-on-click="() => this.runMethod('action_open_terminate_wizard')">
                            <i class="fa fa-trash"/> Terminar
                        </button>
                    </div>
                </div>

                <div class="o_pcm_cols2">
                    <div class="o_pcm_card">
                        <h2>AWS</h2>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Instance ID</span><span class="o_pcm_mono" t-out="d.aws_instance_id"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Tipo</span><span t-out="d.instance_type or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Región</span><span t-out="d.region or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">SO</span><span t-out="d.os_type or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Disco</span><span t-out="d.disk_size_gb ? d.disk_size_gb + ' GB' : '—'"/></div>
                    </div>
                    <div class="o_pcm_card">
                        <h2>Red y asociación</h2>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">IP pública</span><span class="o_pcm_mono" t-out="d.public_ip or '—'"/></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">IP privada</span><span class="o_pcm_mono" t-out="d.private_ip or '—'"/></div>
                        <div class="o_pcm_kv">
                            <span class="o_pcm_muted">Entorno</span>
                            <span t-if="d.environment_id" class="o_pcm_link"
                                  t-on-click="() => this.openRecord('primate.cloud.environment', d.environment_id, d.environment_name)"
                                  t-out="d.environment_name"/>
                            <span t-else="">—</span>
                        </div>
                        <div class="o_pcm_kv">
                            <span class="o_pcm_muted">Cuenta</span>
                            <span t-if="d.account_id" class="o_pcm_link"
                                  t-on-click="() => this.openRecord('primate.cloud.account', d.account_id, d.account_name)"
                                  t-out="d.account_name"/>
                            <span t-else="">—</span>
                        </div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Último sync</span><span t-out="d.last_sync_date or '—'"/></div>
                    </div>
                </div>

                <!-- Métricas (Fase 9): sin agente, RAM/disco = "requiere agente" -->
                <div class="o_pcm_section_head o_pcm_section_bar">
                    <h2>Métricas</h2>
                    <div class="o_pcm_actions">
                        <span class="o_pcm_muted" t-if="d.metrics and d.metrics.at">
                            <i class="fa fa-clock-o"/> datos al <t t-out="d.metrics.at"/>
                        </span>
                        <button t-if="d.state === 'running'" class="o_pcm_btn"
                                t-on-click="() => this.refreshMetrics()">
                            <i class="fa fa-refresh"/> Actualizar
                        </button>
                    </div>
                </div>
                <div class="o_pcm_card" t-if="d.metrics">
                    <div class="o_pcm_cols2">
                        <div class="o_pcm_kv"><span class="o_pcm_muted">CPU</span>
                            <span t-if="d.metrics.has_data"><t t-out="d.metrics.cpu"/> %</span>
                            <span t-else="" class="o_pcm_muted">sin datos aún</span></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Status check</span>
                            <span t-if="d.metrics.has_data and d.metrics.status_check_failed >= 1" class="o_pcm_err">Fallando</span>
                            <span t-elif="d.metrics.has_data">OK</span>
                            <span t-else="" class="o_pcm_muted">sin datos aún</span></div>
                        <!-- RAM/disco: métrica AUSENTE (sin agente), nunca cero. -->
                        <div class="o_pcm_kv"><span class="o_pcm_muted">RAM</span>
                            <span class="o_pcm_muted">requiere agente CloudWatch</span></div>
                        <div class="o_pcm_kv"><span class="o_pcm_muted">Disco</span>
                            <span class="o_pcm_muted">requiere agente CloudWatch</span></div>
                    </div>
                </div>

                <!-- Logs on-demand (SSM). No se persisten. -->
                <div class="o_pcm_section_head o_pcm_section_bar">
                    <h2>Logs</h2>
                </div>
                <div class="o_pcm_card">
                    <div class="o_pcm_actions">
                        <select t-model="logs.source" class="o_pcm_select">
                            <option value="odoo">Odoo</option>
                            <option value="nginx">Nginx</option>
                            <option value="postgres">PostgreSQL</option>
                            <option value="os">Sistema</option>
                        </select>
                        <select t-model.number="logs.lines" class="o_pcm_select">
                            <option value="100">100 líneas</option>
                            <option value="500">500 líneas</option>
                            <option value="1000">1000 líneas</option>
                        </select>
                        <input type="text" t-model="logs.grep" class="o_pcm_input"
                               placeholder="Filtrar texto…"/>
                        <button class="o_pcm_btn o_pcm_btn_accent"
                                t-att-disabled="d.state !== 'running' or logs.loading"
                                t-on-click="() => this.fetchLogs()">
                            <i class="fa fa-download"/> Traer logs
                        </button>
                        <button class="o_pcm_btn" t-if="logs.text"
                                t-on-click="() => this.downloadLogs()">
                            <i class="fa fa-file-text-o"/> Descargar
                        </button>
                    </div>
                    <div t-if="logs.loading" class="o_pcm_muted">Trayendo logs…</div>
                    <pre t-elif="logs.text" class="o_pcm_logs" t-out="logs.text"/>
                    <div t-else="" class="o_pcm_muted">Elegí una fuente y traé los logs.</div>
                </div>

                <!-- Bases de datos que corren en este servidor -->
                <div class="o_pcm_card" t-if="d.databases and d.databases.length">
                    <h2>Bases de datos</h2>
                    <div t-foreach="d.databases" t-as="db" t-key="db.id"
                         class="o_pcm_line o_pcm_line_click"
                         t-on-click="() => this.openRecord('primate.cloud.database', db.id, db.name)">
                        <div class="o_pcm_line_main">
                            <span class="o_pcm_line_name" t-out="db.name"/>
                        </div>
                        <i class="fa fa-angle-right o_pcm_muted"/>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
