<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="primate_cloud_manager.App">
        <div class="o_pcm_app" t-att-style="rootStyle"
             t-att-data-pcm-appearance="state.appearance">
            <!-- Sidebar navy -->
            <div class="o_pcm_sidebar">
                <div class="o_pcm_brand">
                    <span class="o_pcm_brand_mark">P</span>
                    <span class="o_pcm_brand_word">Primate Cloud</span>
                </div>
                <div class="o_pcm_nav">
                    <div t-foreach="navGroups" t-as="group" t-key="group.key" class="o_pcm_nav_group">
                        <div t-if="group.label" class="o_pcm_nav_group_head"
                             t-on-click="() => this.toggleGroup(group.key)">
                            <span t-out="group.label"/>
                            <i t-attf-class="fa {{ isGroupCollapsed(group.key) ? 'fa-angle-right' : 'fa-angle-down' }}"/>
                        </div>
                        <div t-if="!isGroupCollapsed(group.key)" class="o_pcm_nav_items">
                            <div t-foreach="group.items" t-as="item" t-key="item.key"
                                 t-attf-class="o_pcm_nav_item {{ isNavActive(item) ? 'o_pcm_active' : '' }}"
                                 t-on-click="() => this.onNav(item)">
                                <i t-attf-class="fa {{ item.icon }}"/>
                                <span t-out="item.label"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="o_pcm_foot">PCM · by PrimateUy</div>
            </div>

            <!-- Contenido -->
            <div class="o_pcm_content">
                <div class="o_pcm_header">
                    <!-- Izquierda: breadcrumb (refleja la pila; cada nivel vuelve). -->
                    <div class="o_pcm_breadcrumb">
                        <t t-foreach="breadcrumb" t-as="crumb" t-key="crumb_index">
                            <span t-if="crumb_index > 0" class="o_pcm_crumb_sep">/</span>
                            <span t-attf-class="o_pcm_crumb {{ crumb_index === breadcrumb.length - 1 ? 'o_pcm_crumb_active' : '' }}"
                                  t-on-click="() => this.goTo(crumb_index)"
                                  t-out="crumb.title"/>
                        </t>
                    </div>

                    <!-- Derecha: controles alineados con borde inferior del header. -->
                    <div class="o_pcm_header_actions">
                        <!-- Idioma (ES activo; EN es placeholder hasta la fase i18n). -->
                        <div class="o_pcm_lang" role="group" aria-label="Idioma">
                            <button type="button" class="o_pcm_lang_opt o_pcm_lang_active">ES</button>
                            <button type="button" class="o_pcm_lang_opt" disabled="disabled"
                                    title="Próximamente">EN</button>
                        </div>

                        <span class="o_pcm_hdr_div"/>

                        <!-- Acento -->
                        <div class="o_pcm_accent_picker">
                            <span t-foreach="accentList" t-as="a" t-key="a.name"
                                  t-attf-class="o_pcm_swatch {{ isAccentActive(a.name) ? 'o_pcm_swatch_active' : '' }}"
                                  t-attf-style="background: {{ a.color }};"
                                  t-att-title="a.name"
                                  t-on-click="() => this.setAccent(a.name)"/>
                        </div>

                        <span class="o_pcm_hdr_div"/>

                        <!-- Claro / oscuro -->
                        <div class="o_pcm_appearance_toggle">
                            <button t-foreach="appearanceList" t-as="ap" t-key="ap.name"
                                    type="button"
                                    t-attf-class="o_pcm_appearance_opt {{ isAppearanceActive(ap.name) ? 'o_pcm_appearance_opt_active' : '' }}"
                                    t-att-title="ap.label"
                                    t-on-click="() => this.setAppearance(ap.name)">
                                <i t-attf-class="fa {{ ap.icon }}"/>
                            </button>
                        </div>

                        <!-- Alertas (placeholder; la campana ya vive en el shell). -->
                        <button type="button" class="o_pcm_hdr_icon" title="Alertas">
                            <i class="fa fa-bell-o"/>
                        </button>

                        <!-- Avatar + menú de usuario. Contiene la SALIDA de la app
                             (Volver a Odoo / Cerrar sesión) y el picker de Estilo. -->
                        <div class="o_pcm_user">
                            <button type="button" class="o_pcm_avatar"
                                    t-att-title="userName"
                                    t-on-click="() => this.toggleUserMenu()">
                                <span t-out="userInitials"/>
                            </button>
                            <t t-if="state.userMenuOpen">
                                <div class="o_pcm_menu_scrim"
                                     t-on-click="() => this.closeUserMenu()"/>
                                <div class="o_pcm_user_menu">
                                    <div class="o_pcm_user_menu_head">
                                        <span class="o_pcm_user_menu_name" t-out="userName"/>
                                        <span class="o_pcm_user_menu_sub">Primate Cloud</span>
                                    </div>
                                    <div class="o_pcm_menu_group">
                                        <div class="o_pcm_menu_label">Estilo</div>
                                        <button t-foreach="themeList" t-as="t" t-key="t.name"
                                                type="button"
                                                t-attf-class="o_pcm_menu_item {{ isThemeActive(t.name) ? 'o_pcm_menu_item_on' : '' }}"
                                                t-on-click="() => this.setTheme(t.name)">
                                            <i t-attf-class="fa {{ isThemeActive(t.name) ? 'fa-check' : 'fa-circle-o' }}"/>
                                            <span t-out="t.label"/>
                                        </button>
                                    </div>
                                    <div class="o_pcm_menu_sep"/>
                                    <button type="button" class="o_pcm_menu_item"
                                            t-on-click="() => this.exitToOdoo()">
                                        <i class="fa fa-sign-out"/><span>Volver a Odoo</span>
                                    </button>
                                    <button type="button"
                                            class="o_pcm_menu_item o_pcm_menu_item_danger"
                                            t-on-click="() => this.logout()">
                                        <i class="fa fa-power-off"/><span>Cerrar sesión</span>
                                    </button>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <div t-attf-class="o_pcm_screen {{ isNativeScreen ? 'o_pcm_native' : '' }}">
                    <Inicio t-if="current.type === 'inicio'"
                            userName="userName"
                            onOpenEnv="(id, name) => this.openEnvDetail(id, name)"/>
                    <Costos t-elif="current.type === 'costos'"/>
                    <Entornos t-elif="current.type === 'entornos'"
                              onOpenEnv="(id, name) => this.openEnvDetail(id, name)"
                              onManage="(id, name) => this.manageEnv(id, name)"/>
                    <Proyectos t-elif="current.type === 'proyectos'"
                               onOpenProject="(id, name) => this.openRecord('primate.cloud.project', id, name)"/>
                    <EntornoDetalle t-elif="current.type === 'envDetail'"
                                    envId="current.resId"
                                    onBack="() => this.pop()"
                                    onManage="(id, name) => this.manageEnv(id, name)"
                                    onOpenRecord="(m, i, n) => this.openRecord(m, i, n)"/>
                    <ServidorDetalle t-elif="current.type === 'serverDetail'"
                                     serverId="current.resId"
                                     onOpenRecord="(m, i, n) => this.openRecord(m, i, n)"
                                     onOpenInstance="(id, n) => this.openRecord('primate.cloud.instance', id, n)"/>
                    <InstanciaDetalle t-elif="current.type === 'instanceDetail'"
                                      instanceId="current.resId"
                                      initialTab="current.tab"
                                      onTabChange="(t) => this.setDetailTab(t)"
                                      onOpenRecord="(m, i, n) => this.openRecord(m, i, n)"/>
                    <BaseDatosDetalle t-elif="current.type === 'dbDetail'"
                                      recordId="current.resId"
                                      onOpenRecord="(m, i, n) => this.openRecord(m, i, n)"/>
                    <RepositorioDetalle t-elif="current.type === 'repoDetail'"
                                        recordId="current.resId"
                                        onOpenRecord="(m, i, n) => this.openRecord(m, i, n)"/>
                    <DespliegueDetalle t-elif="current.type === 'depDetail'"
                                       recordId="current.resId"
                                       onOpenRecord="(m, i, n) => this.openRecord(m, i, n)"/>
                    <DnsDetalle t-elif="current.type === 'dnsDetail'"
                                recordId="current.resId"
                                onOpenRecord="(m, i, n) => this.openRecord(m, i, n)"/>
                    <CuentaDetalle t-elif="current.type === 'accountDetail'"
                                   recordId="current.resId"
                                   onOpenRecord="(m, i, n) => this.openRecord(m, i, n)"/>
                    <ProyectoDetalle t-elif="current.type === 'projectDetail'"
                                     recordId="current.resId"
                                     onOpenRecord="(m, i, n) => this.openRecord(m, i, n)"/>
                    <!-- Vistas nativas embebidas: la navegación (volver) va por el breadcrumb. -->
                    <View t-elif="current.type === 'nativeList'"
                          t-props="nativeListProps" t-key="'list-' + current.model"/>
                    <View t-elif="current.type === 'nativeForm'"
                          t-props="nativeFormProps"
                          t-key="'form-' + current.model + '-' + (current.resId or 'new')"/>
                    <div t-else="" class="o_pcm_card o_pcm_muted">
                        Seleccioná una sección del menú.
                    </div>
                </div>
            </div>

            <!-- Drawer de wizard (panel lateral, dentro de la app; no modal stock). -->
            <PcmWizardDrawer t-if="state.wizard"
                             model="state.wizard.model"
                             context="state.wizard.context"
                             title="state.wizard.title"
                             onClose="() => this.closeWizardDrawer()"/>

            <!-- Drawer de formulario OWL propio (DNS, etc.): mismo chrome. -->
            <PcmFormDrawer t-if="state.form"
                           component="state.form.component"
                           props="state.form.props"
                           title="state.form.title"
                           onClose="() => this.closeFormDrawer()"/>
        </div>
    </t>

</templates>
