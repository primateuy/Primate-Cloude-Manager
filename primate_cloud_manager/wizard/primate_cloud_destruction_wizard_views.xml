<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_destruction_wizard_form" model="ir.ui.view">
        <field name="name">primate.cloud.destruction.wizard.form</field>
        <field name="model">primate.cloud.destruction.wizard</field>
        <field name="arch" type="xml">
            <form string="Operación destructiva">
                <field name="step" invisible="1" force_save="1"/>
                <field name="ticket_id" invisible="1" force_save="1"/>
                <field name="token" invisible="1" force_save="1"/>
                <field name="res_model" invisible="1" force_save="1"/>
                <field name="res_id" invisible="1" force_save="1"/>
                <field name="action" invisible="1" force_save="1"/>
                <field name="callback" invisible="1" force_save="1"/>
                <field name="callback_params" invisible="1" force_save="1"/>

                <!-- Paso 1: impacto -->
                <group invisible="step != 'impact'">
                    <div class="alert alert-danger" role="alert" colspan="2">
                        <b>⚠ Acción IRREVERSIBLE.</b> Leé el impacto completo.
                        El ticket vence en <field name="ttl_minutes" readonly="1" force_save="1"
                        class="oe_inline"/> minutos.
                    </div>
                    <field name="impact_text" readonly="1" force_save="1" nolabel="1" colspan="2"/>
                </group>

                <!-- Paso 2: nombre exacto, tipeado a mano -->
                <group invisible="step != 'name'">
                    <div class="alert alert-warning" role="alert" colspan="2">
                        Escribí a mano el nombre EXACTO del recurso
                        (la comparación la hace el servidor).
                    </div>
                    <field name="typed_name" required="step == 'name'"/>
                </group>

                <!-- Paso 3: re-autenticación -->
                <group invisible="step != 'reauth'">
                    <div class="alert alert-danger" role="alert" colspan="2">
                        Último paso: confirmá tu identidad. Al aceptar, la
                        destrucción se ejecuta.
                    </div>
                    <field name="password" password="True"
                           required="step == 'reauth'"/>
                    <field name="totp_code"/>
                </group>

                <footer>
                    <button name="action_next_from_impact" type="object"
                            string="Entiendo el impacto — continuar"
                            class="btn-danger" invisible="step != 'impact'"/>
                    <button name="action_confirm_name" type="object"
                            string="Confirmar nombre" class="btn-danger"
                            invisible="step != 'name'"/>
                    <button name="action_execute" type="object"
                            string="EJECUTAR LA DESTRUCCIÓN" class="btn-danger"
                            invisible="step != 'reauth'"/>
                    <button name="action_cancel" type="object"
                            string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
