<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ec2_create_wizard_form" model="ir.ui.view">
        <field name="name">primate.cloud.ec2.create.wizard.form</field>
        <field name="model">primate.cloud.ec2.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear instancia EC2">
                <group>
                    <group string="General">
                        <field name="name" placeholder="Ej.: forum-prod"/>
                        <field name="account_id"/>
                        <field name="environment_id"/>
                        <field name="region"/>
                    </group>
                    <group string="Cómputo">
                        <field name="instance_type"/>
                        <field name="os_type"/>
                        <label for="image_id"/>
                        <div class="o_row">
                            <field name="image_id" nolabel="1"
                                   placeholder="(vacío = se resuelve Ubuntu 24.04 de la región)"/>
                            <button name="action_resolve_ami" type="object"
                                    string="Resolver AMI" class="btn-secondary"/>
                        </div>
                        <field name="disk_size_gb"/>
                    </group>
                </group>
                <group string="Red y acceso (opcional)">
                    <field name="key_name"/>
                    <field name="security_group_ids" placeholder="sg-aaa, sg-bbb"/>
                    <field name="subnet_id"/>
                    <field name="instance_profile"/>
                </group>
                <footer>
                    <button name="action_create_instance" type="object"
                            string="Crear instancia" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ec2_create_wizard" model="ir.actions.act_window">
        <field name="name">Crear instancia EC2</field>
        <field name="res_model">primate.cloud.ec2.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
