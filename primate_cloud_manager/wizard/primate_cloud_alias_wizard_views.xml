<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_alias_wizard_form" model="ir.ui.view">
        <field name="name">primate.cloud.alias.wizard.form</field>
        <field name="model">primate.cloud.alias.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar dominio adicional">
                <field name="instance_id" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    Una <b>segunda URL</b> para la misma instancia. El registro
                    <b>A</b> lo cargás vos (en el DNS del cliente) apuntando a
                    la IP del servidor. PCM verifica, monta un vhost en
                    paralelo y emite su certificado. El dominio principal y
                    <code>web.base.url</code> <b>no se tocan</b>: las dos URLs
                    quedan sirviendo. Si algo falla, lo nuevo se desarma.
                </div>
                <group>
                    <group>
                        <field name="current_domain" readonly="1"/>
                        <field name="server_ip" readonly="1"/>
                    </group>
                    <group>
                        <field name="domain" placeholder="cliente.com"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Verificar y agregar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
