<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard: parámetros de la importación -->
    <record id="view_server_import_wizard_form" model="ir.ui.view">
        <field name="name">primate.cloud.server.import.wizard.form</field>
        <field name="model">primate.cloud.server.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar servidores">
                <div class="alert alert-info" role="alert">
                    Trae los servidores EC2 de la cuenta y sus instancias Odoo
                    para clasificarlos después por cliente. <strong>Todo lo que
                    entra queda en solo lectura permanente</strong>: se mira
                    (gemelo) y no se opera, sin excepción. En los servidores
                    sólo corre el documento SSM de lectura. Lo que PCM ya
                    gestiona no se importa (se lista aparte).
                </div>
                <group>
                    <group string="Cuenta">
                        <field name="account_id"/>
                    </group>
                    <group string="Alcance">
                        <field name="all_regions"/>
                        <field name="regions" invisible="all_regions"
                               required="not all_regions"
                               placeholder="us-east-1, sa-east-1"/>
                        <field name="regiones_validas"/>
                        <field name="include_stopped"/>
                        <field name="discover"/>
                    </group>
                </group>
                <footer>
                    <button name="action_import" type="object"
                            string="Importar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Corrida -->
    <record id="view_server_import_list" model="ir.ui.view">
        <field name="name">primate.cloud.server.import.list</field>
        <field name="model">primate.cloud.server.import</field>
        <field name="arch" type="xml">
            <list class="o_pcm" create="0" delete="0"
                  decoration-info="state in ('draft', 'running')"
                  decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="account_id"/>
                <field name="regions"/>
                <field name="state" widget="badge"/>
                <field name="progress" widget="progressbar"/>
                <field name="total_servers"/>
                <field name="unreachable_count"/>
                <field name="unrecognized_count"/>
                <field name="started_at"/>
            </list>
        </field>
    </record>

    <record id="view_server_import_form" model="ir.ui.view">
        <field name="name">primate.cloud.server.import.form</field>
        <field name="model">primate.cloud.server.import</field>
        <field name="arch" type="xml">
            <form string="Importación de servidores" class="o_pcm" create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Corrida">
                            <field name="account_id"/>
                            <field name="regions"/>
                            <field name="include_stopped"/>
                            <field name="discover"/>
                            <field name="user_id"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                        </group>
                        <group string="Avance">
                            <field name="progress" widget="progressbar"/>
                            <field name="total_servers"/>
                            <field name="processed"/>
                            <field name="created_count"/>
                            <field name="updated_count"/>
                            <field name="online_count"/>
                            <field name="unreachable_count"/>
                            <field name="discovered_count"/>
                            <field name="unrecognized_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Servidores" name="lineas">
                            <field name="line_ids">
                                <list decoration-warning="ssm_state == 'unreachable'"
                                      decoration-danger="discovery_state == 'error'"
                                      decoration-muted="discovery_state == 'skipped'">
                                    <field name="name"/>
                                    <field name="aws_instance_id"/>
                                    <field name="region"/>
                                    <field name="instance_state"/>
                                    <field name="sync_result"/>
                                    <field name="ssm_state"/>
                                    <field name="discovery_state"/>
                                    <field name="instances_found"/>
                                    <field name="databases_found"/>
                                    <field name="ec2_instance_id" optional="hide"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="ec2_instance_id"/>
                                            <field name="aws_instance_id"/>
                                            <field name="region"/>
                                            <field name="instance_state"/>
                                        </group>
                                        <group>
                                            <field name="sync_result"/>
                                            <field name="ssm_state"/>
                                            <field name="ping_status"/>
                                            <field name="discovery_state"/>
                                            <field name="instances_found"/>
                                            <field name="databases_found"/>
                                        </group>
                                    </group>
                                    <group string="Pasos manuales"
                                           invisible="not manual_steps">
                                        <field name="manual_steps" nolabel="1" colspan="2"/>
                                    </group>
                                    <group string="Detalle" invisible="not detail">
                                        <field name="detail" nolabel="1" colspan="2"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Reporte" name="reporte">
                            <field name="report" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_server_import" model="ir.actions.act_window">
        <field name="name">Importaciones de servidores</field>
        <field name="res_model">primate.cloud.server.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin importaciones todavía.</p>
            <p>Abrí una Cuenta AWS y usá «Importar servidores».</p>
        </field>
    </record>

    <menuitem id="menu_server_import"
              name="Importaciones de servidores"
              parent="menu_primate_cloud_operations"
              action="action_server_import"
              groups="primate_cloud_manager.group_cloud_admin"
              sequence="80"/>

</odoo>
