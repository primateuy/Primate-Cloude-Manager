<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_backup_list" model="ir.ui.view">
        <field name="name">primate.cloud.backup.list</field>
        <field name="model">primate.cloud.backup</field>
        <field name="arch" type="xml">
            <list string="Backups" class="o_pcm" create="false">
                <field name="backup_date"/>
                <field name="name"/>
                <field name="environment_id"/>
                <field name="database_id"/>
                <field name="backup_type" widget="pcm_category_chip"/>
                <field name="purpose" widget="pcm_category_chip"/>
                <field name="source" optional="hide"/>
                <field name="size_mb" optional="show"/>
                <field name="expiry_date" optional="hide"/>
                <field name="state" widget="pcm_status_badge"/>
            </list>
        </field>
    </record>

    <record id="view_backup_form" model="ir.ui.view">
        <field name="name">primate.cloud.backup.form</field>
        <field name="model">primate.cloud.backup</field>
        <field name="arch" type="xml">
            <form string="Backup" class="o_pcm" create="false" edit="false" delete="false">
                <header>
                    <button name="action_restore" type="object"
                            string="Restaurar…" class="btn-primary"
                            groups="primate_cloud_manager.group_cloud_admin"
                            invisible="state != 'completed'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="environment_id"/>
                            <field name="database_id"/>
                            <field name="backup_type"/>
                            <field name="purpose"/>
                            <field name="source"/>
                            <field name="state" widget="pcm_status_badge"/>
                        </group>
                        <group string="Detalle">
                            <field name="backup_date"/>
                            <field name="expiry_date"/>
                            <field name="size_mb"/>
                            <field name="s3_bucket"/>
                            <field name="s3_key"/>
                            <field name="s3_filestore_key"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_backup" model="ir.actions.act_window">
        <field name="name">Backups</field>
        <field name="res_model">primate.cloud.backup</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay backups registrados.</p>
            <p>Acá queda la evidencia de cada backup ejecutado por PCM o detectado en AWS.</p>
        </field>
    </record>

</odoo>
