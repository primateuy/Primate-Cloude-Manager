<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dns_record_list" model="ir.ui.view">
        <field name="name">primate.cloud.dns.record.list</field>
        <field name="model">primate.cloud.dns.record</field>
        <field name="arch" type="xml">
            <list string="Registros DNS" create="false">
                <field name="name"/>
                <field name="record_type"/>
                <field name="record_value"/>
                <field name="ttl"/>
                <field name="environment_id"/>
                <field name="sync_state" widget="pcm_status_badge"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="view_dns_record_form" model="ir.ui.view">
        <field name="name">primate.cloud.dns.record.form</field>
        <field name="model">primate.cloud.dns.record</field>
        <field name="arch" type="xml">
            <form string="Registro DNS">
                <header>
                    <button name="action_open_edit" type="object" string="Editar"
                            class="btn-primary" invisible="state == 'deleted'"
                            groups="primate_cloud_manager.group_cloud_admin"/>
                    <button name="action_check_sync_state" type="object" string="Verificar"
                            invisible="state == 'deleted'"
                            groups="primate_cloud_manager.group_cloud_admin"/>
                    <button name="action_open_delete" type="object" string="Eliminar"
                            class="btn-secondary" invisible="state == 'deleted'"
                            groups="primate_cloud_manager.group_cloud_admin"/>
                    <field name="sync_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="record_type" readonly="1"/>
                            <field name="record_value" readonly="1"/>
                            <field name="ttl" readonly="1"/>
                            <field name="record_value_aws" readonly="1"
                                   invisible="sync_state != 'divergent'"/>
                        </group>
                        <group>
                            <field name="account_id" readonly="1"/>
                            <field name="environment_id" readonly="1"/>
                            <field name="hosted_zone_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="last_change_id" readonly="1"/>
                            <field name="last_sync_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dns_record_search" model="ir.ui.view">
        <field name="name">primate.cloud.dns.record.search</field>
        <field name="model">primate.cloud.dns.record</field>
        <field name="arch" type="xml">
            <search string="Buscar registros DNS">
                <field name="name"/>
                <field name="record_value"/>
                <field name="environment_id"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'record_type'}"/>
                    <filter name="group_account" string="Cuenta" context="{'group_by': 'account_id'}"/>
                    <filter name="group_zone" string="Zona" context="{'group_by': 'hosted_zone_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dns_record" model="ir.actions.act_window">
        <field name="name">Registros DNS</field>
        <field name="res_model">primate.cloud.dns.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dns_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay registros DNS sincronizados.</p>
            <p>Se importan desde Route 53 al sincronizar la cuenta AWS.</p>
        </field>
    </record>

</odoo>
