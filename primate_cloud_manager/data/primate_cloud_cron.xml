<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_sync_accounts" model="ir.cron">
        <field name="name">Primate Cloud: sincronizar recursos AWS</field>
        <field name="model_id" ref="model_primate_cloud_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_all_accounts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Horario: encola backups gestionados cuya ventana venció (reintento
         acotado a 1/hora si un intento falló y la ventana sigue descubierta). -->
    <record id="cron_run_managed_backups" model="ir.cron">
        <field name="name">Primate Cloud: ejecutar backups gestionados</field>
        <field name="model_id" ref="model_primate_cloud_environment"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_managed_backups()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_mark_expired_backups" model="ir.cron">
        <field name="name">Primate Cloud: marcar backups expirados</field>
        <field name="model_id" ref="model_primate_cloud_backup"/>
        <field name="state">code</field>
        <field name="code">model._cron_mark_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:15:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Corre después del sync (02:00): la evidencia RDS del inventario está fresca. -->
    <record id="cron_check_backup_compliance" model="ir.cron">
        <field name="name">Primate Cloud: verificar cumplimiento de respaldos</field>
        <field name="model_id" ref="model_primate_cloud_environment"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_backup_compliance()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:30:00')"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
