<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_sync_accounts" model="ir.cron">
        <field name="name">Primate Cloud: sincronizar recursos AWS</field>
        <field name="model_id" ref="model_primate_cloud_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_all_accounts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Horario: encola backups gestionados cuya ventana venció (reintento
         acotado a 1/hora si un intento falló y la ventana sigue descubierta). -->
    <record id="cron_run_managed_backups" model="ir.cron">
        <field name="name">Primate Cloud: ejecutar backups gestionados</field>
        <field name="model_id" ref="model_primate_cloud_environment"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_managed_backups()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_mark_expired_backups" model="ir.cron">
        <field name="name">Primate Cloud: marcar backups expirados</field>
        <field name="model_id" ref="model_primate_cloud_backup"/>
        <field name="state">code</field>
        <field name="code">model._cron_mark_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:15:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Corre después del sync (02:00): la evidencia RDS del inventario está fresca. -->
    <record id="cron_check_backup_compliance" model="ir.cron">
        <field name="name">Primate Cloud: verificar cumplimiento de respaldos</field>
        <field name="model_id" ref="model_primate_cloud_environment"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_backup_compliance()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:30:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Costos: pull diario de Cost Explorer por cuenta (dato con retardo;
         04:45, después del sync/respaldos). -->
    <record id="cron_pull_costs" model="ir.cron">
        <field name="name">Primate Cloud: consultar costos (Cost Explorer)</field>
        <field name="model_id" ref="model_primate_cloud_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_pull_costs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:45:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Retención de métricas: crudas 14 días, downsample diario, tope 365. -->
    <record id="cron_cleanup_snapshots" model="ir.cron">
        <field name="name">Primate Cloud: retención de métricas</field>
        <field name="model_id" ref="model_primate_cloud_monitor_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_snapshots()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:15:00')"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Métricas: snapshot horario de CloudWatch por cuenta (EC2 + RDS). -->
    <record id="cron_snapshot_metrics" model="ir.cron">
        <field name="name">Primate Cloud: snapshot de métricas (CloudWatch)</field>
        <field name="model_id" ref="model_primate_cloud_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_snapshot_metrics()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Anti-zombi de propagación DNS: reintenta los registros en 'pending'
         (INSYNC → finaliza; PENDING demasiado viejo → error honesto). -->
    <record id="cron_resync_pending_dns" model="ir.cron">
        <field name="name">Primate Cloud: reintentar propagación DNS pendiente</field>
        <field name="model_id" ref="model_primate_cloud_dns_record"/>
        <field name="state">code</field>
        <field name="code">model._cron_resync_pending()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
